{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "ConnectionStrings": {
    "Analitica": "Server=localhost;Database=OpinionesAnaliticaDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "ResenasWeb": "Server=localhost;Database=ResenasWebDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Etl": {
    "IntervaloMinutos": 0
  },
  "Fuentes": {
    "Csv": {
      "Habilitada": true,
      "Ruta": "Data/encuestas.csv"
    },
    "BaseDatos": {
      "Habilitada": true,
      "Origen": "ResenasWebDB.dbo.Resenas",
      "Consulta": "SELECT NombreCliente AS Cliente, EmailCliente AS Email, Producto, Comentario, Calificacion, Fecha FROM dbo.Resenas ORDER BY IdResena"
    },
    "Api": {
      "Habilitada": true,
      "BaseUrl": "https://jsonplaceholder.typicode.com/",
      "Endpoint": "comments",
      "RedSocial": "API Demo",
      "ApiKey": "",
      "MaxRegistros": 50,
      "TimeoutSegundos": 30
    }
  }
}
